{
  "expo": {
    "name": "MindFree",
    "slug": "mindfree",
    "owner": "pedr0gs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mindfree",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mindfree.app",
      "infoPlist": {
        "CFBundleLocalizations": [
          "pt-BR",
          "pt-PT",
          "en",
          "es",
          "fr",
          "de",
          "it",
          "ja",
          "ko",
          "zh-Hans",
          "hi",
          "ar"
        ]
      }
    },
    "android": {
      "package": "com.mindfree.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#10142E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10142E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B9A6FF"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "MindFree",
              "displayName": "MindFree",
              "description": "Suas tarefas de hoje e, à noite, o atalho para esvaziar a mente.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/ios/mindfree-widget.tsx"
              },
              "android": null
            },
            {
              "name": "SeuCeu",
              "displayName": "Seu céu",
              "description": "As estrelas que você acendeu no mês.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "initialLayout": "./src/widgets/ios/sky-widget.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "MindFree",
              "label": "Hoje e esta noite",
              "description": "Suas tarefas de hoje e, à noite, o atalho para esvaziar a mente.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/hoje-e-esta-noite.png"
            },
            {
              "name": "MindFreeAtalho",
              "label": "Próxima tarefa",
              "description": "De dia, a próxima tarefa. À noite, o botão para esvaziar a mente.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/proxima-tarefa.png"
            },
            {
              "name": "SeuCeu",
              "label": "Seu céu",
              "description": "As estrelas que você acendeu no mês.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/seu-ceu.png"
            }
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "pt-BR",
            "pt-PT",
            "en",
            "es",
            "fr",
            "de",
            "it",
            "ja",
            "ko",
            "zh-Hans",
            "hi",
            "ar"
          ]
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "O MindFree usa o microfone para ouvir o que você quer lembrar antes de dormir.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O MindFree acessa suas fotos para você postar uma conquista no mural.",
          "cameraPermission": "O MindFree usa a câmera para você fotografar uma conquista.",
          "microphonePermission": "O MindFree usa o microfone para ouvir o que você quer lembrar antes de dormir."
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-secure-store",
      "./plugins/android-release",
      "./plugins/android-widget-placeholder",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.mindfree.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.mindfree.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "5264b2b9-2737-43fe-9197-230f9b102709"
      }
    }
  }
}

# Copie para supabase/.env (que não vai para o Git), preencha e envie com:
#   npx.cmd supabase secrets set --env-file supabase/.env --project-ref SEU_REF
# Depois de enviar, pode apagar o supabase/.env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A mesma chave publicável que está no .env.local do app.
APP_PUBLISHABLE_KEY=
